#include<bits/stdc++.h>
using namespace std;

int main(){
    int n1;
    cin >> n1;

    vector<int> a(n1);

    // First array ke elements input le rahe hain
    for(int i = 0; i < n1; i++){
        cin >> a[i];
    }

    int n2;
    cin >> n2;

    vector<int> b(n2);

    // Second array ke elements input le rahe hain
    for(int i = 0; i < n2; i++){
        cin >> b[i];
    }

    int i = 0; // First array ka pointer
    int j = 0; // Second array ka pointer

    vector<int> ans;

    // Jab tak dono arrays mein elements available hain
    while(i < n1 && j < n2){

        // Agar first array ka element chhota hai
        // Toh first pointer ko aage badhao
        if(a[i] < b[j]){
            i++;
        }

        // Agar second array ka element chhota hai
        // Toh second pointer ko aage badhao
        else if(b[j] < a[i]){
            j++;
        }

        // Agar dono elements equal hain
        else{
            ans.push_back(a[i]); // Common element insert karo

            i++; // First pointer aage badhao
            j++; // Second pointer aage badhao
        }
    }

    // Answer ke saare common elements print karo
    for(int k = 0; k < ans.size(); k++){
        cout << ans[k] << " ";
    }

    return 0;
}
