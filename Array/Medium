//3. Rearrange array elements by sign
//solution:
class Solution {
public:
    vector<int> rearrangeArray(vector<int>& nums) {
        // First, I calculate the size of the array and create an answer vector of the same size. Then, I initialize two pointers, pos = 0 and neg = 1, where pos is used to store positive numbers at even indices and neg is used to store negative numbers at odd indices. After that, I traverse the original array using a loop. If the current element is positive, I place it at the pos index and increment pos by 2. Otherwise, I place it at the neg index and increment neg by 2. In this way, positive and negative elements are arranged alternately while maintaining their original relative order. Finally, I return the answer vector. The time complexity is O(n) and the space complexity is O(n).
        int n=nums.size();
        vector<int>ans(n);
        int pos=0;
        int neg=1;
        for(int i=0;i<n;i++){
            if(nums[i]>0){
                ans[pos]=nums[i];
                pos+=2;
            }else{
                ans[neg]=nums[i];
                neg+=2;
            }
        }
        return ans;
    }
};

//4.Print the matrix in spiral manner
class Solution {
public:
    vector<int> spiralOrder(vector<vector<int>>& matrix) {
        int n=matrix.size();// Total number of rows in the matrix
        int m=matrix[0].size(); // Total number of columns in the first row

        int left=0;// Starting column
        int top=0; // Starting row
        int right=m-1;// Last column
        int bottom=n-1;// Last row

        vector<int>ans;// Empty vector to store spiral order elements 
         // Loop tab tak chalega jab tak valid rows aur columns available hain

        while(left<=right && top<=bottom){
        //traverse from left to right;
        for(int i=left;i<=right;i++){
            ans.push_back(matrix[top][i]);
        }
        top++;// Top row complete, ab next row par move karo


        //traverse from top to bottom;
        for(int i=top;i<=bottom;i++){
            ans.push_back(matrix[i][right]);
        }
        right--;// Right column complete, ab previous column par move karo

        //traverse from right to left;

        if(top<=bottom){
            for(int i=right;i>=left;i--){
                ans.push_back(matrix[bottom][i]);
            }
            bottom--;// Bottom row complete, ab previous row par move karo
        }
        
        //traverse from bottom to top

        if(left<=right){
            for(int i=bottom;i>=top;i--){
                ans.push_back(matrix[i][left]);
            }
            left++;// Left column complete, ab next column par move karo
        }
        }
        return ans;
    }
};

