class Solution {
  public:
    void rotateMatrix(vector<vector<int>>& mat) {
        // code here
        int n=mat.size();// Sabse pehle matrix ka size nikalenge
        
        // Step 1: Transpose the matrix
         // Rows ko columns mein convert karenge
        for(int i=0;i<n-1;i++){
            for(int j=i+1;j<n;j++){
                swap(mat[i][j],mat[j][i]);// Main diagonal ke across elements ko swap karenge
            }
        }
        
        // Step 2: Har column ko reverse karenge
         // Isse matrix 90 degree anti-clockwise rotate ho jayegi
        for(int j=0;j<n;j++){
            // Har column ke liye top aur bottom pointers initialize karenge
            int top=0;
            int bottom=n-1;
            // Current column ke top aur bottom elements ko swap karenge
            while(top<=bottom){
                swap(mat[top][j],mat[bottom][j]);
                top++; // Top pointer ko neeche move karenge
                bottom--;// Bottom pointer ko upar move karenge
            }
        }
        
    }
};

#include <vector>
#include <unordered_map>
using namespace std;

class Solution {
public:
    vector<int> twoSum(vector<int>& nums, int target) {
        int n=nums.size();
        unordered_map<int,int>mp;
        for(int i=0;i<n;i++){
            int current=nums[i];
            int more=target-current;
            if(mp.find(more)!=mp.end()){
                return {mp[more],i};
            }
            mp[current]=i;

        }
        return {};
    }
};


//In this approach, we use an unordered_map to store array elements along with their indices. We traverse the array and calculate the complement of the current element using target - current. Then, we check whether this complement already exists in the map using mp.find(more). If it exists, we have found the two elements whose sum equals the target, so we return their indices. Otherwise, we store the current element and its index in the map using mp[current] = i. If no valid pair is found after traversing the entire array, we return an empty vector.

//time:o(n) in best
//space:o(n)

//if we are using map inplace of unordered map then time complexity would be o(nlogn)
