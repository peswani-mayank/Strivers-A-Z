//17. Rotate array on gfg 

//Given an array arr[]. Rotate the array to the left (counter-clockwise direction) by d steps, 
//where d is a positive integer. Do the mentioned change in the array in place.
//Note: Consider the array as circular.
//Examples :
//Input: arr[] = [1, 2, 3, 4, 5], d = 2
//Output: [3, 4, 5, 1, 2]
//Explanation: when rotated by 2 elements, it becomes [3, 4, 5, 1, 2].

//SOLUTION:
class Solution {
public:
    void rotateArr(vector<int>& arr, int d) {
        int n=arr.size();
        d=d%n;//d = d % n is used to reduce the number of rotations 
        //so that we don't perform unnecessary operations.
        //Explanation: The modulo (%) operator returns the remainder 
        //after division. In array rotation, when we rotate an array n times, 
        ///it returns to its original position. Therefore, if d is greater 
        //than n, we only need to perform the remaining rotations.
        
        vector<int>temp;
        
        for(int i=0;i<d;i++) {
            temp.push_back(arr[i]);
        }
        for(int i=d;i<n;i++){
            arr[i-d]=arr[i];
        }
        for(int i=n-d;i<n;i++) {
            arr[i]=temp[i-(n-d)];
        }
    }
};

// In this approach, we first calculate the size of the array using arr.size() 
//and then apply d = d % n to handle cases where the number of rotations is greater 
//than the array size. Next, we create a temporary vector and store the first d elements 
//of the original array in it because these elements need to be moved to the end after 
//left rotation. After storing them, we shift all the remaining elements towards the 
//left by d positions using arr[i-d] = arr[i]. Finally, we copy the elements stored in 
//the temporary vector to the last d positions of the original array. This completes 
//the left rotation of the array by d positions.

// Example: If the array is [1, 2, 3, 4, 5] and d = 2, 
//the first two elements [1, 2] are stored in a temporary vector, 
//the remaining elements [3, 4, 5] are shifted to the left, 
//and [1, 2] are placed at the end. The final array becomes [3, 4, 5, 1, 2].

// Time Complexity: O(n)
// Auxiliary Space: O(d)

//18. Majority Element-I Striver sheet 
Given an integer array nums of size n, return the majority element of the array.
The majority element of an array is an element that appears more than n/2 times in the array. The array is guaranteed to have a majority element.
Example 1:
Input: nums = [7, 0, 0, 1, 7, 7, 2, 7, 7]
Output: 7
Explanation:
The number 7 appears 5 times in the 9 sized array

//Solution:
class Solution {
public:
    int majorityElement(vector<int>& nums) {
        int n=nums.size();
        map<int,int>mp;
        for(int i=0;i<n;i++){
            mp[nums[i]]++;
        }
        int ans=0;
        for(auto it:mp){
            if(it.second>n/2){
                ans=it.first;
            }
        }
        return ans;    
    }
};

//19. Maximum Consecutive Ones striver sheet

Given a binary array nums, return the maximum number of consecutive 1s in the array.
A binary array is an array that contains only 0s and 1s.
Example 1:
Input: nums = [1, 1, 0, 0, 1, 1, 1, 0]
Output: 3
Explanation:
The maximum consecutive 1s are present from index 4 to index 6, amounting to 3 1s

//solution
class Solution {
public:
    int findMaxConsecutiveOnes(vector<int>& nums) {
        int n=nums.size();
        int max1=0;
        int count=0;
        for(int i=0;i<n;i++){
            if(nums[i]==1){
                count++;
                max1=max(max1,count);
            }else{
                count=0;
            }
        }
        return max1;
        
    }
};

//Maximum Consecutive Ones problem mein humein array mein continuously aane wale 1s ki maximum count find karni 
hoti hai. Sabse pehle n = nums.size() se array ka size calculate karte hain, phir max1 = 0 aur count = 0 
initialize karte hain, jahan count current consecutive ones ko count karega aur max1 ab tak ki maximum consecutive 
ones ki count store karega. Uske baad for(int i=0; i<n; i++) loop se array ke har element ko traverse karte hain. 
