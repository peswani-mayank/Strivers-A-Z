#include<iostream>
using namespace std;
int main(){
    //int arr[] = {13, 46, 24, 52, 20, 9}; 
    int arr[] = {1,2,3,4,5,6}; 
   int n=6;  
   for(int i=n-1;i>=1;i--){
       int didSwap=0;//apn n idr optimise krne k liye ye variable liya agar swap nhi ho rha h to inner loop m nhi  jaye sidha hi bhar aajaye jis se time complexity o(n) ho jyegi or we can say // Assume initially no swap happened
       for(int j=0;j<=i-1;j++){
           if(arr[j]>arr[j+1]){
               int temp=arr[j+1];
               arr[j+1]=arr[j];
               arr[j]=temp;
               didSwap=1; //idr didSwap 1 isliye hoga agar swap ki need hui to 0 s 1 hojyega or bhar aakr print krdega jitni baar bi swap hua hoga
           }
       }
       if(didSwap==0){//This means: if no swapping happened in the entire pass, the array is already sorted, so stop.
           break;
       }
       cout<<"runs"<<endl;
   }
   for(int i=0;i<n;i++){
       cout<<arr[i]<<" ";
   }
}

