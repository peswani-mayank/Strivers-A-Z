// You are given an integer n. Return the integer formed by placing the digits of n in reverse order.
// Example 1
// Input: n = 25
// Output: 52
// Explanation: Reverse of 25 is 52.

//code1:  code is for reverse the number
// 1234
//  ↓
// 4321  ← creates/stores this number in rev
#include<iostream>                 // Input-output ke liye library
using namespace std;               // std baar-baar likhne ki zarurat nahi
int main(){
    int n;                         // Number store karne ke liye variable
    cin >> n;                      // User se number input lena
    int rev = 0;                   // Reversed number ko store karne ke liye
    while(n > 0){                  // Jab tak number 0 nahi hota, loop chalega
        int last = n % 10;         // Number ki last digit nikalna
        rev = rev * 10 + last;     // Last digit ko reversed number mein add karna
        n = n / 10;                // Last digit hata dena
    }
    cout << rev;                   // Reversed number print karna

    return 0;                      // Program successfully end
}
