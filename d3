question 1: 
Given an integer n. You need to recreate the pattern given below for any value of N. Let's say for N = 5, the pattern should look like as below:

*
**
***
****
*****
Print the pattern in the function given to you.
  solution:
  #include<iostream>
 using namespace std;
 void pattern2(int n){
     for(int i=0;i<n;i++){  //outer loop for rows
         for(int j=0;j<=i;j++){ //inner loop for column 
           //is question m pattern dekhe to 1st row m 1 star h 2nd row 2 star  and so on 
           //isliye inner loop m j ko i link krege jitna i badhta jyega us according j ko bi krte jyrege
           //when i =0 it run from 0 to 0
           //when i=1 it runs from 0 to 1
           //when i=2 it runs from 0 to 2 and so on 
             cout<<"* ";
         }
         cout<<endl;
     }
 }
 int main(){
     int n;
     cin>>n;
     pattern2(n);
 }

