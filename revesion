//Armstrong number
#include<bits/stdc++.h>
using namespace std;
int main(){
    int n;
    cin>>n;
    int temp=n;
    int sum=0;
    int count=0;
    int temp2=n;
    while(temp2>0){
        count++;
        temp2=temp2/10;
    }
    while(n>0){
        int last=n%10;
        sum+=pow(last,count);
        n=n/10;
    }
    if(sum==temp){
        cout<<"Arm";
    }else{
        cout<<"Not Arm";
    }
}
